{
  "name": "plugin-starter",
  "version": "1.0.0",
  "description": "A starter template for building Yapmod plugins",
  "main": "dist/index.js",
  "scripts": {
    "build": "yapmod build --entry src/index.tsx --outfile dist/index.js",
    "dev": "yapmod dev --entry src/index.tsx --outfile dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yapmod",
    "plugin",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@yapmod/builder": "^1.3.0",
    "@yapmod/types": "^1.1.0",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  }
}
