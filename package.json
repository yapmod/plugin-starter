{
  "name": "plugin-starter",
  "version": "1.0.0",
  "description": "A starter template for building Yapmod plugins",
  "scripts": {
    "build": "pnpm typecheck && node scripts/plugins.mjs build",
    "dev": "node scripts/plugins.mjs dev",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yapmod",
    "plugin",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@yapmod/builder": "^1.3.0",
    "@yapmod/types": "^1.1.0",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1"
}
